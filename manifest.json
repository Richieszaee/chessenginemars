{
  "manifest_version": 3,
  "name": "Bossfrommars Analysis — Arrows & Move Labels",
  "version": "2.1.0",
  "description": "Live Stockfish analysis for Chess.com: best-move arrows, eval bar and chess.com-style move labels — Brilliant, Great, Best, Inaccuracy, Mistake, Blunder.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Bossfrommars Analysis — Arrows & Move Labels",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "permissions": [
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://www.chess.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "chess.js",
        "review.js",
        "icons.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}